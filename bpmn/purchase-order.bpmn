<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PurchaseOrder" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_PurchaseOrder" name="Online Purchase Order Processing" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Customer Places Order">
      <bpmn:outgoing>Flow_Start_Check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckAvailability" name="Check Product Availability">
      <bpmn:incoming>Flow_Start_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Gate1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Available" name="Product Available?">
      <bpmn:incoming>Flow_Check_Gate1</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate1_Payment</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate1_OutOfStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyOutOfStock" name="Notify Customer - Out of Stock">
      <bpmn:incoming>Flow_Gate1_OutOfStock</bpmn:incoming>
      <bpmn:outgoing>Flow_OutOfStock_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_OutOfStock" name="Out of Stock">
      <bpmn:incoming>Flow_OutOfStock_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ProcessPayment" name="Process Payment">
      <bpmn:incoming>Flow_Gate1_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Gate2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccess" name="Payment Successful?">
      <bpmn:incoming>Flow_Payment_Gate2</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate2_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate2_Failure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyPaymentFailure" name="Notify Customer - Payment Failed">
      <bpmn:incoming>Flow_Gate2_Failure</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentFailure_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_PaymentFailed" name="Payment Failed">
      <bpmn:incoming>Flow_PaymentFailure_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ConfirmOrder" name="Confirm Order">
      <bpmn:incoming>Flow_Gate2_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Prepare</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrepareShipment" name="Prepare Product for Shipment">
      <bpmn:incoming>Flow_Confirm_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Ship</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShipOrder" name="Ship Order">
      <bpmn:incoming>Flow_Prepare_Ship</bpmn:incoming>
      <bpmn:outgoing>Flow_Ship_SendConfirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendShippingConfirmation" name="Send Shipping Confirmation to Customer">
      <bpmn:incoming>Flow_Ship_SendConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_SendConfirm_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Completed" name="Order Completed">
      <bpmn:incoming>Flow_SendConfirm_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Check" sourceRef="StartEvent_1" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_Check_Gate1" sourceRef="Task_CheckAvailability" targetRef="Gateway_Available" />
    <bpmn:sequenceFlow id="Flow_Gate1_Payment" name="Yes" sourceRef="Gateway_Available" targetRef="Task_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_Gate1_OutOfStock" name="No" sourceRef="Gateway_Available" targetRef="Task_NotifyOutOfStock" />
    <bpmn:sequenceFlow id="Flow_OutOfStock_End" sourceRef="Task_NotifyOutOfStock" targetRef="EndEvent_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_Payment_Gate2" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentSuccess" />
    <bpmn:sequenceFlow id="Flow_Gate2_Confirm" name="Yes" sourceRef="Gateway_PaymentSuccess" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_Gate2_Failure" name="No" sourceRef="Gateway_PaymentSuccess" targetRef="Task_NotifyPaymentFailure" />
    <bpmn:sequenceFlow id="Flow_PaymentFailure_End" sourceRef="Task_NotifyPaymentFailure" targetRef="EndEvent_PaymentFailed" />
    <bpmn:sequenceFlow id="Flow_Confirm_Prepare" sourceRef="Task_ConfirmOrder" targetRef="Task_PrepareShipment" />
    <bpmn:sequenceFlow id="Flow_Prepare_Ship" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_Ship_SendConfirm" sourceRef="Task_ShipOrder" targetRef="Task_SendShippingConfirmation" />
    <bpmn:sequenceFlow id="Flow_SendConfirm_End" sourceRef="Task_SendShippingConfirmation" targetRef="EndEvent_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_PurchaseOrder">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="140" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="116" y="148" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckAvailability_di" bpmnElement="Task_CheckAvailability">
        <dc:Bounds x="230" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Available_di" bpmnElement="Gateway_Available" isMarkerVisible="true">
        <dc:Bounds x="400" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="399" y="76" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyOutOfStock_di" bpmnElement="Task_NotifyOutOfStock">
        <dc:Bounds x="375" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OutOfStock_di" bpmnElement="EndEvent_OutOfStock">
        <dc:Bounds x="525" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="333" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="500" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentSuccess_di" bpmnElement="Gateway_PaymentSuccess" isMarkerVisible="true">
        <dc:Bounds x="650" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="76" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyPaymentFailure_di" bpmnElement="Task_NotifyPaymentFailure">
        <dc:Bounds x="625" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PaymentFailed_di" bpmnElement="EndEvent_PaymentFailed">
        <dc:Bounds x="775" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="754" y="333" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmOrder_di" bpmnElement="Task_ConfirmOrder">
        <dc:Bounds x="750" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareShipment_di" bpmnElement="Task_PrepareShipment">
        <dc:Bounds x="900" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="1050" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendShippingConfirmation_di" bpmnElement="Task_SendShippingConfirmation">
        <dc:Bounds x="1200" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1350" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1325" y="155" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Check_di" bpmnElement="Flow_Start_Check">
        <di:waypoint x="176" y="130" />
        <di:waypoint x="230" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_Gate1_di" bpmnElement="Flow_Check_Gate1">
        <di:waypoint x="330" y="130" />
        <di:waypoint x="400" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gate1_Payment_di" bpmnElement="Flow_Gate1_Payment">
        <di:waypoint x="450" y="130" />
        <di:waypoint x="500" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="466" y="105" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gate1_OutOfStock_di" bpmnElement="Flow_Gate1_OutOfStock">
        <di:waypoint x="425" y="155" />
        <di:waypoint x="425" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="433" y="203" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OutOfStock_End_di" bpmnElement="Flow_OutOfStock_End">
        <di:waypoint x="475" y="310" />
        <di:waypoint x="525" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Payment_Gate2_di" bpmnElement="Flow_Payment_Gate2">
        <di:waypoint x="600" y="130" />
        <di:waypoint x="650" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gate2_Confirm_di" bpmnElement="Flow_Gate2_Confirm">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="750" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="716" y="105" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gate2_Failure_di" bpmnElement="Flow_Gate2_Failure">
        <di:waypoint x="675" y="155" />
        <di:waypoint x="675" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="683" y="203" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentFailure_End_di" bpmnElement="Flow_PaymentFailure_End">
        <di:waypoint x="725" y="310" />
        <di:waypoint x="775" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirm_Prepare_di" bpmnElement="Flow_Confirm_Prepare">
        <di:waypoint x="850" y="130" />
        <di:waypoint x="900" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Prepare_Ship_di" bpmnElement="Flow_Prepare_Ship">
        <di:waypoint x="1000" y="130" />
        <di:waypoint x="1050" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ship_SendConfirm_di" bpmnElement="Flow_Ship_SendConfirm">
        <di:waypoint x="1150" y="130" />
        <di:waypoint x="1200" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendConfirm_End_di" bpmnElement="Flow_SendConfirm_End">
        <di:waypoint x="1300" y="130" />
        <di:waypoint x="1350" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
