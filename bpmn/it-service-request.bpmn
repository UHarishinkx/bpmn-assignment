<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ITServiceRequest" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_ITServiceRequest" name="IT Service Request Handling" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Employee Reports IT Problem">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitRequest" name="Submit IT Support Request">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Register</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RegisterRequest" name="Register Request">
      <bpmn:incoming>Flow_Submit_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_CheckSeverity</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckSeverity" name="Check Severity of the Problem">
      <bpmn:incoming>Flow_Register_CheckSeverity</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSeverity_Gate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Severity" name="Severity Level?">
      <bpmn:incoming>Flow_CheckSeverity_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Low</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_High</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssignSupport" name="Assign to Support Technician">
      <bpmn:incoming>Flow_Gate_Low</bpmn:incoming>
      <bpmn:outgoing>Flow_Support_Merge1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignSenior" name="Assign to Senior Technician">
      <bpmn:incoming>Flow_Gate_High</bpmn:incoming>
      <bpmn:outgoing>Flow_Senior_Merge1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Merge1" name="Technician Assigned">
      <bpmn:incoming>Flow_Support_Merge1</bpmn:incoming>
      <bpmn:incoming>Flow_Senior_Merge1</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge1_Investigate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Investigate" name="Investigate the Problem">
      <bpmn:incoming>Flow_Merge1_Investigate</bpmn:incoming>
      <bpmn:outgoing>Flow_Investigate_Gate2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Resolvable" name="Resolvable Internally?">
      <bpmn:incoming>Flow_Investigate_Gate2</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate2_Fix</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate2_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FixProblem" name="Fix the Problem">
      <bpmn:incoming>Flow_Gate2_Fix</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_Merge2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Escalate" name="Escalate to External Service Provider">
      <bpmn:incoming>Flow_Gate2_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_Merge2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Merge2" name="Resolution Complete">
      <bpmn:incoming>Flow_Fix_Merge2</bpmn:incoming>
      <bpmn:incoming>Flow_Escalate_Merge2</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge2_UpdateStatus</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UpdateStatus" name="Update Request Status">
      <bpmn:incoming>Flow_Merge2_UpdateStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateStatus_SendResolution</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendResolution" name="Send Resolution Notification to Employee">
      <bpmn:incoming>Flow_UpdateStatus_SendResolution</bpmn:incoming>
      <bpmn:outgoing>Flow_SendResolution_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Resolved" name="Request Resolved">
      <bpmn:incoming>Flow_SendResolution_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_Submit_Register" sourceRef="Task_SubmitRequest" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_Register_CheckSeverity" sourceRef="Task_RegisterRequest" targetRef="Task_CheckSeverity" />
    <bpmn:sequenceFlow id="Flow_CheckSeverity_Gate" sourceRef="Task_CheckSeverity" targetRef="Gateway_Severity" />
    <bpmn:sequenceFlow id="Flow_Gate_Low" name="Low Severity" sourceRef="Gateway_Severity" targetRef="Task_AssignSupport" />
    <bpmn:sequenceFlow id="Flow_Gate_High" name="High Severity" sourceRef="Gateway_Severity" targetRef="Task_AssignSenior" />
    <bpmn:sequenceFlow id="Flow_Support_Merge1" sourceRef="Task_AssignSupport" targetRef="Gateway_Merge1" />
    <bpmn:sequenceFlow id="Flow_Senior_Merge1" sourceRef="Task_AssignSenior" targetRef="Gateway_Merge1" />
    <bpmn:sequenceFlow id="Flow_Merge1_Investigate" sourceRef="Gateway_Merge1" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_Investigate_Gate2" sourceRef="Task_Investigate" targetRef="Gateway_Resolvable" />
    <bpmn:sequenceFlow id="Flow_Gate2_Fix" name="Yes" sourceRef="Gateway_Resolvable" targetRef="Task_FixProblem" />
    <bpmn:sequenceFlow id="Flow_Gate2_Escalate" name="No" sourceRef="Gateway_Resolvable" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Fix_Merge2" sourceRef="Task_FixProblem" targetRef="Gateway_Merge2" />
    <bpmn:sequenceFlow id="Flow_Escalate_Merge2" sourceRef="Task_Escalate" targetRef="Gateway_Merge2" />
    <bpmn:sequenceFlow id="Flow_Merge2_UpdateStatus" sourceRef="Gateway_Merge2" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_UpdateStatus_SendResolution" sourceRef="Task_UpdateStatus" targetRef="Task_SendResolution" />
    <bpmn:sequenceFlow id="Flow_SendResolution_End" sourceRef="Task_SendResolution" targetRef="EndEvent_Resolved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ITServiceRequest">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="140" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="148" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest">
        <dc:Bounds x="230" y="90" width="100" height="80" />
