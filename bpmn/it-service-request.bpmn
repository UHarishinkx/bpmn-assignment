      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateStatus_SendResolution_di" bpmnElement="Flow_UpdateStatus_SendResolution">
        <di:waypoint x="1725" y="130" />
        <di:waypoint x="1775" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendResolution_End_di" bpmnElement="Flow_SendResolution_End">
