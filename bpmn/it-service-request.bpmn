        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Senior_Merge1_di" bpmnElement="Flow_Senior_Merge1">
        <di:waypoint x="880" y="310" />
        <di:waypoint x="1050" y="310" />
        <di:waypoint x="1050" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gate2_Escalate_di" bpmnElement="Flow_Gate2_Escalate">
        <di:waypoint x="1300" y="155" />
        <di:waypoint x="1300" y="213" />
        <di:waypoint x="1330" y="213" />
        <di:waypoint x="1330" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1308" y="176" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalate_Merge2_di" bpmnElement="Flow_Escalate_Merge2">
        <di:waypoint x="1380" y="310" />
        <di:waypoint x="1550" y="310" />
        <di:waypoint x="1550" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Support_Merge1_di" bpmnElement="Flow_Support_Merge1">
        <di:waypoint x="975" y="130" />
        <di:waypoint x="1025" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merge1_Investigate_di" bpmnElement="Flow_Merge1_Investigate">
        <di:waypoint x="1075" y="130" />
        <di:waypoint x="1125" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Investigate_Gate2_di" bpmnElement="Flow_Investigate_Gate2">
        <di:waypoint x="1225" y="130" />
